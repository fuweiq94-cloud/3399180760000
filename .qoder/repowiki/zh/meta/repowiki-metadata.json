{"knowledge_relations":[{"id":1064,"source_id":"7801417d-a9af-4727-9595-35223c94222c","target_id":"7766c4dd-ca9b-4739-80a2-2dcd066686a6","source_type":"WIKI_ITEM","target_type":"WIKI_ITEM","relationship_type":"PARENT_CHILD","extra":"Wiki parent-child relationship: 7801417d-a9af-4727-9595-35223c94222c -\u003e 7766c4dd-ca9b-4739-80a2-2dcd066686a6","gmt_create":"2026-09-02T22:56:44.9051416+08:00","gmt_modified":"2026-09-02T22:56:44.9051416+08:00"},{"id":1065,"source_id":"7801417d-a9af-4727-9595-35223c94222c","target_id":"de096de5-f1da-4ea4-b13b-3a871a34c1b5","source_type":"WIKI_ITEM","target_type":"WIKI_ITEM","relationship_type":"PARENT_CHILD","extra":"Wiki parent-child relationship: 7801417d-a9af-4727-9595-35223c94222c -\u003e de096de5-f1da-4ea4-b13b-3a871a34c1b5","gmt_create":"2026-09-02T22:56:44.9071996+08:00","gmt_modified":"2026-09-02T22:56:44.9071996+08:00"}],"wiki_catalogs":[{"id":"4279e04b-fddc-4974-a7b2-44cee904bb3d","repo_id":"4a16f1b6-ef9c-4da2-9381-3a048d1bb802","name":"项目概述","description":"project-overview","prompt":"为D3QN贪吃蛇AI训练系统创建全面的项目概述内容。详细介绍项目的目标、核心功能特性和技术架构。解释D3QN算法（Dueling Double Deep Q-Network）的基本原理，以及它如何结合Dueling DQN和Double DQN的优势。描述项目的整体结构，包括贪吃蛇游戏环境、神经网络架构、智能体逻辑和训练系统。说明项目的技术栈（PyTorch、Gymnasium、Pygame等）和依赖关系。提供快速开始指南，包括环境安装、训练启动和基本使用方法。面向初学者解释深度强化学习概念，同时为有经验的开发者提供技术细节。使用与代码库一致的术语。","progress_status":"completed","dependent_files":"README.md,requirements.txt","gmt_create":"2026-09-02T22:54:43.3484874+08:00","gmt_modified":"2026-09-02T22:55:37.2685133+08:00","raw_data":"WikiEncrypted:"},{"id":"fd6af73a-aa44-4d21-9899-04506e11b53c","repo_id":"4a16f1b6-ef9c-4da2-9381-3a048d1bb802","name":"智能体逻辑实现","description":"agent-logic","prompt":"为D3QN智能体逻辑实现创建详细的技术文档。深入解释D3QNAgent类的核心功能，包括ε-贪婪探索策略的实现原理和参数调优。详细描述经验回放缓冲区的管理机制，包括Transition数据结构的定义、存储策略和采样算法。解释目标网络更新机制，包括周期性同步策略和参数传递过程。说明动作选择策略，包括训练模式下的探索与利用平衡。详细描述优化过程，包括双重Q学习目标计算、损失函数优化和梯度裁剪技术。提供超参数配置指南，包括学习率、折扣因子、批量大小等关键参数的作用和调整策略。包含具体的代码示例和使用模式。","parent_id":"0fb353ea-8be8-4a73-bd75-8422ce1ec779","progress_status"